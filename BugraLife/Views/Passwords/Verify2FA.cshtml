@{
    ViewData["Title"] = "Güvenlik Doğrulaması";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0"><i class="bi bi-shield-lock-fill me-2"></i>Güvenlik Kontrolü</h5>
                </div>
                <div class="card-body p-4 text-center">

                    <div class="mb-4">
                        <i class="bi bi-phone text-primary" style="font-size: 3rem;"></i>
                        <p class="mt-2">
                            Şifrelerinizi görüntülemek için lütfen <strong>Google Authenticator</strong> uygulamasındaki kodu giriniz.
                        </p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Verify2FA" autocomplete="off">
                        <div class="mb-3">
                            <input type="text" name="code" class="form-control form-control-lg text-center fw-bold letter-spacing-2"
                                   placeholder="000 000" maxlength="6" autofocus required
                                   style="letter-spacing: 5px; font-size: 1.5rem;">
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Doğrula ve Giriş Yap
                            </button>
                        </div>
                    </form>

                    <div class="mt-3">
                        <a href="/Home/Index" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left"></i> Ana Sayfaya Dön
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>