@using System.Globalization
@model IEnumerable<Movement>

@{
    ViewData["Title"] = "Cari Hareketleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}
@Html.AntiForgeryToken()

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-info"><i class="bi bi-arrow-left-right me-2"></i>Cari / Borç-Alacak Hareketleri</h5>
        <button type="button" class="btn btn-info text-white btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-lg me-1"></i> Yeni Hareket
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table datatable table-hover table-striped align-middle" data-order='[[ 0, "desc" ]]'>
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Cari (Borçlu/Alacaklı)</th>
                        <th>Varlık Türü</th>
                        <th>İlgili Kişi</th>
                        <th>Açıklama</th>
                        <th class="text-end pe-4">Miktar/Tutar</th>
                        <th width="100">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.movement_id">
                            <td class="col-date" data-order="@item.movement_date.ToString("yyyy-MM-dd")">
                                @item.movement_date.ToString("dd.MM.yyyy")
                            </td>
                            <td class="fw-bold col-debtor">@(item.Debtor?.debtor_name ?? "-")</td>
                            <td class="col-ingredient">
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">
                                    @(item.Ingredient?.ingredient_name ?? "-")
                                </span>
                            </td>
                            <td class="col-person">@(item.Person?.person_name ?? "-")</td>
                            <td class="text-muted small col-desc">@item.movement_description</td>
                            <td class="text-end fw-bold pe-4 col-amount @(item.movement_amount < 0 ? "text-danger" : "text-success")">
                                @item.movement_amount.ToString("N2", trCulture)
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-warning btn-sm text-white btn-edit"
                                            data-id="@item.movement_id" data-debtor="@item.debtor_id"
                                            data-ingredient="@item.ingredient_id" data-person="@item.person_id"
                                            data-amount="@item.movement_amount.ToString("N2", trCulture)"
                                            data-date="@item.movement_date.ToString("yyyy-MM-dd")"
                                            data-desc="@item.movement_description">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" onclick="deleteItem(@item.movement_id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-info">Yeni Cari Hareketi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tarih</label>
                            <input type="date" name="movement_date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Miktar</label>
                            <input type="text" name="movement_amount" class="form-control money-input" required placeholder="0,00" autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cari (Kim?)</label>
                        <select name="debtor_id" class="aga-select" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var d in ViewBag.Debtors)
                            {
                                <option value="@d.debtor_id">@d.debtor_name</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Varlık Türü</label>
                            <select name="ingredient_id" class="aga-select" required>
                                <option value="">Seçiniz...</option>
                                @foreach (var i in ViewBag.Ingredients)
                                {
                                    <option value="@i.ingredient_id">@i.ingredient_name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">İlgili Kişi (Bizden)</label>
                            <select name="person_id" class="aga-select" required>
                                <option value="">Seçiniz...</option>
                                @foreach (var p in ViewBag.Persons)
                                {
                                    <option value="@p.person_id">@p.person_name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea name="movement_description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-info text-white">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-warning">Hareketi Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" method="post">
                <input type="hidden" name="movement_id" id="edit_id">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tarih</label>
                            <input type="date" name="movement_date" id="edit_date" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Miktar</label>
                            <input type="text" name="movement_amount" id="edit_amount" class="form-control money-input" required autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cari</label>
                        <select name="debtor_id" id="edit_debtor" class="aga-select" required>
                            @foreach (var d in ViewBag.Debtors)
                            {
                                <option value="@d.debtor_id">@d.debtor_name</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Varlık Türü</label>
                            <select name="ingredient_id" id="edit_ingredient" class="aga-select" required>
                                @foreach (var i in ViewBag.Ingredients)
                                {
                                    <option value="@i.ingredient_id">@i.ingredient_name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">İlgili Kişi</label>
                            <select name="person_id" id="edit_person" class="aga-select" required>
                                @foreach (var p in ViewBag.Persons)
                                {
                                    <option value="@p.person_id">@p.person_name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea name="movement_description" id="edit_desc" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning text-white">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            // --- 1. PARA MASKESİ (Binlik Nokta, Kuruş Virgül, Eksi Desteği) ---
            $('body').on('input', '.money-input', function() {
                let inputVal = $(this).val();
                let isNegative = inputVal.startsWith('-');
                
                let val = inputVal.replace(/[^\d,]/g, '');
                let parts = val.split(',');
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                
                let result = (isNegative ? '-' : '') + parts[0];
                if (parts.length > 1) {
                    result += ',' + parts[1].substring(0, 2);
                }
                $(this).val(result);
            });

            // --- 2. DÜZENLEME BUTONU ---
            $('.datatable').on('click', '.btn-edit', function() {
                var btn = $(this);
                $('#edit_id').val(btn.data('id'));
                $('#edit_debtor').val(btn.data('debtor')).trigger('change');
                $('#edit_ingredient').val(btn.data('ingredient')).trigger('change');
                $('#edit_person').val(btn.data('person')).trigger('change');
                $('#edit_amount').val(btn.data('amount'));
                $('#edit_date').val(btn.data('date'));
                $('#edit_desc').val(btn.data('desc'));
                $('#editModal').modal('show');
            });

            // --- 3. FORM GÖNDERME ---
            $('#createForm').submit(function(e) { e.preventDefault(); processForm($(this), '/Movement/Create', $(this).find('button[type="submit"]')); });
            $('#editForm').submit(function(e) { e.preventDefault(); processForm($(this), '/Movement/Edit', $(this).find('button[type="submit"]')); });

            function processForm(form, url, btnElement) {
                var formDataArray = form.serializeArray();
                
                // Binlik noktalarını sil, virgülü bırak (C# Turkish Culture uyumu)
                for (var i = 0; i < formDataArray.length; i++) {
                    if (formDataArray[i].name === "movement_amount") {
                        formDataArray[i].value = formDataArray[i].value.replace(/\./g, '');
                        break;
                    }
                }

                disableButton(btnElement);

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formDataArray,
                    success: function(response) {
                        if (response.success) {
                            $('.modal').modal('hide');
                            showToast('success', response.message);
                            location.reload(); // Tablo yapısı ve ilişkiler (Debtor name vs.) için en güvenlisi
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() { showToast('error', 'İşlem sırasında hata oluştu.'); },
                    complete: function() { enableButton(btnElement); }
                });
            }

            function disableButton(btn) { btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>'); }
            function enableButton(btn) { btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i>'); }
        });

        function deleteItem(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu hareket kaydı silinecek!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.post('/Movement/Delete', { id: id, __RequestVerificationToken: token }, function(res) {
                        if (res.success) {
                            showToast('success', res.message);
                            $(`#row-${id}`).fadeOut(500, function() { $(this).remove(); });
                        } else {
                            showToast('error', res.message);
                        }
                    });
                }
            });
        }
    </script>
}