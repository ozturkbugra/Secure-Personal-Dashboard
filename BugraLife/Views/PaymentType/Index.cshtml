@model IEnumerable<PaymentType>
@using System.Globalization

@{
    ViewData["Title"] = "Ödeme Türleri / Hesaplar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.AntiForgeryToken()

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            showToast('success', '@TempData["SuccessMessage"]');
        });
    </script>
}

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-credit-card-2-front me-2"></i>Ödeme Türleri / Hesaplar</h5>

        <div class="d-flex gap-2">
            <button type="button" id="btn-save-order" class="btn btn-success btn-sm rounded-pill px-4 d-none" onclick="submitOrderForm()">
                <i class="bi bi-check-lg me-1"></i> Sıralamayı Kaydet
            </button>

            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Hesap Ekle
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <form id="orderForm" action="/PaymentType/SaveOrder" method="post">
                @Html.AntiForgeryToken()
                <table class="table datatable table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="40"></th>
                            <th width="50" class="text-secondary">Sıra</th>
                            <th class="text-secondary">Hesap Adı</th>
                            <th class="text-secondary">Hesap Türü</th>
                            <th class="text-end text-secondary">Mevcut Bakiye</th>
                            <th width="100" class="text-secondary">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="sortable-tbody">
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.paymenttype_id" class="draggable-row" draggable="true" data-id="@item.paymenttype_id">
                                <td class="text-center text-muted" style="cursor: move;">
                                    <i class="bi bi-grip-vertical fs-5"></i>
                                    <input type="hidden" name="itemIds" value="@item.paymenttype_id" />
                                </td>
                                <td class="text-center fw-bold col-order">@item.paymenttype_order</td>
                                <td class="fw-bold col-name">@item.paymenttype_name</td>

                                <td class="col-type">
                                    @if (item.is_creditcard)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                            <i class="bi bi-credit-card me-1"></i> Kredi Kartı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                            <i class="bi bi-wallet2 me-1"></i> Standart Hesap / Nakit
                                        </span>
                                    }
                                </td>

                                <td class="text-end fw-bold pe-3 col-balance">
                                    @item.paymenttype_balance.ToString("N2") ₺
                                </td>

                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-warning btn-sm text-white btn-edit"
                                                data-id="@item.paymenttype_id"
                                                data-name="@item.paymenttype_name"
                                                data-balance="@Convert.ToString(item.paymenttype_balance, CultureInfo.InvariantCulture)"
                                                data-order="@item.paymenttype_order"
                                                data-creditcard="@item.is_creditcard">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteItem(@item.paymenttype_id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-primary">Yeni Hesap Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Hesap Adı</label>
                        <input type="text" name="paymenttype_name" class="form-control" required placeholder="Örn: Bonus Card, Nakit Kasa...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açılış Bakiyesi</label>
                        <div class="input-group">
                            <input type="text" name="paymenttype_balance" class="form-control currency-input" placeholder="0,00">
                            <span class="input-group-text">₺</span>
                        </div>
                        <div class="small text-muted mt-1">
                            Örnek: <b>19.917,21</b> (Kuruşları <b>VİRGÜL</b> ile ayırınız)
                        </div>
                    </div>

                    <div class="mb-3 border p-3 rounded bg-secondary bg-opacity-10 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold" for="create_is_creditcard">Bu bir Kredi Kartı mı?</label>
                            <div class="small">İşaretlemezseniz normal hesap olur.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_creditcard" value="true" id="create_is_creditcard" style="transform: scale(1.3);">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sıralama</label>
                        <input type="number" name="paymenttype_order" id="create_order" class="form-control" value="@ViewBag.NextOrder">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-warning">Hesap Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" method="post">
                <div class="modal-body">
                    <input type="hidden" name="paymenttype_id" id="edit_id">

                    <div class="mb-3">
                        <label class="form-label">Hesap Adı</label>
                        <input type="text" name="paymenttype_name" id="edit_name" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bakiye (Manuel Düzeltme)</label>
                        <input type="text" name="paymenttype_balance" id="edit_balance" class="form-control currency-input">
                        <div class="small text-muted mt-1">
                            Bakiye değişirse otomatik düzeltme fişi oluşturulur.
                        </div>
                    </div>

                    <div class="mb-3 border p-3 rounded bg-secondary bg-opacity-10 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold" for="edit_is_creditcard">Bu bir Kredi Kartı mı?</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_creditcard" value="true" id="edit_is_creditcard" style="transform: scale(1.3);">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sıralama</label>
                        <input type="number" name="paymenttype_order" id="edit_order" class="form-control">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning text-white">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Sürükleme efekti */
        .draggable-row.dragging {
            opacity: 0.5;
            background-color: rgba(var(--bs-primary-rgb), 0.1) !important;
            border: 2px dashed var(--bs-primary);
        }
    </style>

    <script>
        function submitOrderForm() {
            $('#orderForm').submit();
        }

        $(document).ready(function() {

            // --- HTML5 DRAG AND DROP APİ ---
            const tbody = document.getElementById('sortable-tbody');
            let draggingElement = null;

            tbody.addEventListener('dragstart', (e) => {
                const row = e.target.closest('.draggable-row');
                if (row) {
                    draggingElement = row;
                    row.classList.add('dragging');
                }
            });

            tbody.addEventListener('dragend', (e) => {
                if (draggingElement) {
                    draggingElement.classList.remove('dragging');
                    draggingElement = null;

                    // UI Sıra numaralarını yenile ve butonu göster
                    reCalculateUIOrders();
                }
            });

            tbody.addEventListener('dragover', (e) => {
                e.preventDefault();
                const targetRow = e.target.closest('.draggable-row');
                if (targetRow && targetRow !== draggingElement) {
                    const bounding = targetRow.getBoundingClientRect();
                    const offset = e.clientY - bounding.top - bounding.height / 2;

                    if (offset > 0) {
                        targetRow.after(draggingElement);
                    } else {
                        targetRow.before(draggingElement);
                    }
                }
            });

            function reCalculateUIOrders() {
                let currentNumber = 1;
                $('.draggable-row').each(function() {
                    $(this).find('.col-order').text(currentNumber);
                    currentNumber++;
                });
                // "Sıralamayı Kaydet" butonunu açıyoruz
                $('#btn-save-order').removeClass('d-none');
            }


            // --- A. DÜZENLEME BUTONU ---
            $('.datatable').on('click', '.btn-edit', function() {
                var btn = $(this);

                var id = btn.data('id');
                var name = btn.data('name');
                var balance = btn.data('balance');
                var order = btn.data('order');
                var isCredit = btn.data('creditcard') === "True" || btn.data('creditcard') === true;

                $('#edit_id').val(id);
                $('#edit_name').val(name);
                $('#edit_order').val(order);
                $('#edit_balance').val(formatCurrency(balance));
                $('#edit_is_creditcard').prop('checked', isCredit);

                $('#editModal').modal('show');
            });

            // --- B. PARSE & FORMAT PARA BİRİMİ ---
            function parseCurrency(value) {
                if (!value) return "0";
                var valStr = value.toString();
                valStr = valStr.replace(/\./g, '');
                if (valStr.indexOf(',') === -1 && valStr.indexOf('.') !== -1) {
                     valStr = valStr.replace('.', ',');
                }
                return valStr;
            }

            function formatCurrency(value) {
                if (value === undefined || value === null || isNaN(value)) return '0,00';
                return new Intl.NumberFormat('tr-TR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value);
            }

            // --- C. EKLEME (AJAX) ---
            $('#createForm').submit(function(e) {
                e.preventDefault();
                var btn = $(this).find('button[type="submit"]');
                disableButton(btn);

                processForm($(this), '/PaymentType/Create', btn, '#createModal');
            });

            // --- D. GÜNCELLEME (AJAX) ---
            $('#editForm').submit(function(e) {
                e.preventDefault();
                var btn = $(this).find('button[type="submit"]');
                disableButton(btn);

                processForm($(this), '/PaymentType/Edit', btn, '#editModal');
            });

            // --- E. ORTAK FORM İŞLEYİCİ ---
            function processForm(form, url, btnElement, modalId) {
                var formDataArray = form.serializeArray();

                var balanceIndex = formDataArray.findIndex(x => x.name === "paymenttype_balance");
                if (balanceIndex !== -1) {
                    formDataArray[balanceIndex].value = parseCurrency(formDataArray[balanceIndex].value);
                }

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: $.param(formDataArray),
                    success: function(response) {
                        if (response.success) {
                            $(modalId).modal('hide');
                            showToast('success', response.message);

                            if (url.includes("Create")) {
                                // Listeyi sıralı görmek adına sayfayı yeniliyoruz
                                location.reload();
                            }
                            else if (url.includes("Edit")) {
                                updateRow(response.data);
                            }

                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() { showToast('error', 'Hata oluştu.'); },
                    complete: function() {
                        enableButton(btnElement);
                    }
                });
            }

            function disableButton(btn) {
                btn.prop('disabled', true);
                btn.data('original-text', btn.html());
                btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> İşleniyor...');
            }

            function enableButton(btn) {
                btn.prop('disabled', false);
                btn.html(btn.data('original-text'));
            }

            function getBadgeHtml(isCredit) {
                if (isCredit) {
                    return `<span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="bi bi-credit-card me-1"></i> Kredi Kartı</span>`;
                } else {
                    return `<span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-wallet2 me-1"></i> Standart Hesap / Nakit</span>`;
                }
            }

            function updateRow(data) {
                var row = $(`#row-${data.paymenttype_id}`);

                row.find('.col-order').text(data.paymenttype_order);
                row.find('.col-name').text(data.paymenttype_name);
                row.find('.col-type').html(getBadgeHtml(data.is_creditcard));
                row.find('.col-balance').text(formatCurrency(data.paymenttype_balance) + ' ₺');

                var btn = row.find('.btn-edit');
                btn.data('name', data.paymenttype_name);
                btn.data('order', data.paymenttype_order);
                btn.data('balance', data.paymenttype_balance);
                btn.data('creditcard', data.is_creditcard);

                row.addClass('table-warning');
                setTimeout(() => row.removeClass('table-warning'), 1500);
            }
        });

        // --- SİLME ---
        function deleteItem(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu hesap silinecek!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Vazgeç',
                background: document.documentElement.getAttribute('data-theme') === 'dark' ? '#252b36' : '#fff',
                color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#fff' : '#333'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '/PaymentType/Delete',
                        type: 'POST',
                        data: { id: id, __RequestVerificationToken: token },
                        success: function(response) {
                            if (response.success) {
                                showToast('success', response.message);
                                var row = $(`#row-${id}`);
                                row.fadeOut(500, function() { $(this).remove(); });
                            } else {
                                showToast('error', response.message);
                            }
                        }
                    });
                }
            })
        }
    </script>
}