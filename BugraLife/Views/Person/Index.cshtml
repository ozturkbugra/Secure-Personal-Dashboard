@model IEnumerable<Person>

@{
    ViewData["Title"] = "Kişi Tanımları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.AntiForgeryToken()

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            showToast('success', '@TempData["SuccessMessage"]');
        });
    </script>
}

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-person-vcard me-2"></i>Kişi / Kurum Listesi</h5>

        <div class="d-flex gap-2">
            <button type="button" id="btn-save-order" class="btn btn-success btn-sm rounded-pill px-4 d-none" onclick="submitOrderForm()">
                <i class="bi bi-check-lg me-1"></i> Sıralamayı Kaydet
            </button>

            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Kişi Ekle
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <form id="orderForm" action="/Person/SaveOrder" method="post">
                @Html.AntiForgeryToken()
                <table class="table datatable table-hover table-striped align-middle">
                    <thead>
                        <tr>
                            <th width="40"></th>
                            <th width="50">Sıra</th>
                            <th>Adı</th>
                            <th>Tür</th>
                            <th width="100">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="sortable-tbody">
                        @foreach (var item in Model)
                        {
                            <tr id="row-@item.person_id" class="draggable-row" draggable="true" data-id="@item.person_id">
                                <td class="text-center text-muted" style="cursor: move;">
                                    <i class="bi bi-grip-vertical fs-5"></i>
                                    <input type="hidden" name="itemIds" value="@item.person_id" />
                                </td>
                                <td class="text-center fw-bold col-order">@item.person_order</td>
                                <td class="fw-bold col-name">@item.person_name</td>
                                <td class="col-type">
                                    @if (item.is_bank)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                            <i class="bi bi-bank me-1"></i> Banka Hesabı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">
                                            <i class="bi bi-person me-1"></i> Kişi
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-warning btn-sm text-white btn-edit"
                                                data-id="@item.person_id"
                                                data-name="@item.person_name"
                                                data-bank="@item.is_bank"
                                                data-order="@item.person_order">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button" class="btn btn-danger btn-sm" onclick="deleteItem(@item.person_id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-primary">Yeni Kişi Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kişi Adı</label>
                        <input type="text" name="person_name" class="form-control" required placeholder="Örn: Buğra Öztürk">
                    </div>

                    <div class="mb-3 border p-3 rounded bg-secondary bg-opacity-10 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold" for="create_is_bank">Bu bir banka hesabı mı?</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_bank" value="true" id="create_is_bank" style="transform: scale(1.3);">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sıralama</label>
                        <input type="number" name="person_order" id="create_person_order" class="form-control" value="@ViewBag.NextOrder">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-warning">Kişi Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm" method="post">
                <div class="modal-body">
                    <input type="hidden" name="person_id" id="edit_id">

                    <div class="mb-3">
                        <label class="form-label">Kişi Adı</label>
                        <input type="text" name="person_name" id="edit_name" class="form-control" required>
                    </div>

                    <div class="mb-3 border p-3 rounded bg-secondary bg-opacity-10 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="form-check-label fw-bold" for="edit_is_bank">Bu bir banka hesabı mı?</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_bank" value="true" id="edit_is_bank" style="transform: scale(1.3);">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sıralama</label>
                        <input type="number" name="person_order" id="edit_order" class="form-control">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning text-white">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Sürükleme görsel efekti */
        .draggable-row.dragging {
            opacity: 0.5;
            background-color: rgba(var(--bs-primary-rgb), 0.1) !important;
            border: 2px dashed var(--bs-primary);
        }
    </style>

    <script>
        function submitOrderForm() {
            $('#orderForm').submit();
        }

        $(document).ready(function() {

            // --- HTML5 SÜRÜKLE BIRAK SİSTEMİ ---
            const tbody = document.getElementById('sortable-tbody');
            let draggingElement = null;

            tbody.addEventListener('dragstart', (e) => {
                const row = e.target.closest('.draggable-row');
                if (row) {
                    draggingElement = row;
                    row.classList.add('dragging');
                }
            });

            tbody.addEventListener('dragend', (e) => {
                if (draggingElement) {
                    draggingElement.classList.remove('dragging');
                    draggingElement = null;

                    // UI Sıra numaralarını yenile ve butonu göster
                    reCalculateUIOrders();
                }
            });

            tbody.addEventListener('dragover', (e) => {
                e.preventDefault();
                const targetRow = e.target.closest('.draggable-row');
                if (targetRow && targetRow !== draggingElement) {
                    const bounding = targetRow.getBoundingClientRect();
                    const offset = e.clientY - bounding.top - bounding.height / 2;

                    if (offset > 0) {
                        targetRow.after(draggingElement);
                    } else {
                        targetRow.before(draggingElement);
                    }
                }
            });

            function reCalculateUIOrders() {
                let currentNumber = 1;
                $('.draggable-row').each(function() {
                    $(this).find('.col-order').text(currentNumber);
                    currentNumber++;
                });
                // "Sıralamayı Kaydet" butonunu görünür yapıyoruz
                $('#btn-save-order').removeClass('d-none');
            }


            // --- A. DÜZENLEME BUTONU VE CHECKBOX AYARI ---
            $('.datatable').on('click', '.btn-edit', function() {
                var btn = $(this);

                var id = btn.data('id');
                var name = btn.data('name');

                var isBankString = btn.data('bank');
                var isBank = isBankString === "True" || isBankString === true;

                var order = btn.data('order');

                $('#edit_id').val(id);
                $('#edit_name').val(name);
                $('#edit_order').val(order);
                $('#edit_is_bank').prop('checked', isBank);

                $('#editModal').modal('show');
            });

            // --- B. EKLEME (AJAX) ---
            $('#createForm').submit(function(e) {
                e.preventDefault();
                var btn = $(this).find('button[type="submit"]');
                disableButton(btn);

                processForm($(this), '/Person/Create', btn);
            });

            // --- C. GÜNCELLEME (AJAX) ---
            $('#editForm').submit(function(e) {
                e.preventDefault();
                var btn = $(this).find('button[type="submit"]');
                disableButton(btn);

                processForm($(this), '/Person/Edit', btn);
            });

            // --- D. ORTAK FORM İŞLEYİCİ ---
            function processForm(form, url, btnElement) {
                var formData = form.serialize();

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            $('.modal').modal('hide');
                            showToast('success', response.message);

                            if (url.includes("Create")) {
                                // En güncel listeyi sıralı yakalamak için sayfayı yeniliyoruz
                                location.reload();
                            }
                            else if (url.includes("Edit")) {
                                updateRow(response.data);
                            }
                        } else {
                            showToast('error', response.message);
                        }
                    },
                    error: function() { showToast('error', 'Hata oluştu.'); },
                    complete: function() {
                        enableButton(btnElement);
                    }
                });
            }

            // --- BUTON KİLİTLEME ---
            function disableButton(btn) {
                btn.prop('disabled', true);
                btn.data('original-text', btn.html());
                btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> İşleniyor...');
            }

            function enableButton(btn) {
                btn.prop('disabled', false);
                btn.html(btn.data('original-text'));
            }

            // --- ROZET HTML ÜRETİCİ ---
            function getBadgeHtml(isBank) {
                if (isBank) {
                    return `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary"><i class="bi bi-bank me-1"></i> Banka Hesabı</span>`;
                } else {
                    return `<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary"><i class="bi bi-person me-1"></i> Kişi</span>`;
                }
            }

            function updateRow(data) {
                var row = $(`#row-${data.person_id}`);

                row.find('.col-order').text(data.person_order);
                row.find('.col-name').text(data.person_name);
                row.find('.col-type').html(getBadgeHtml(data.is_bank));

                var btn = row.find('.btn-edit');
                btn.data('name', data.person_name);
                btn.data('bank', data.is_bank);
                btn.data('order', data.person_order);

                row.addClass('table-warning');
                setTimeout(() => row.removeClass('table-warning'), 1500);
            }
        });

        // --- E. SİLME (Sayfa Yenilemeden) ---
        function deleteItem(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu kayıt silinecek!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Vazgeç',
                background: document.documentElement.getAttribute('data-theme') === 'dark' ? '#252b36' : '#fff',
                color: document.documentElement.getAttribute('data-theme') === 'dark' ? '#fff' : '#333'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '/Person/Delete',
                        type: 'POST',
                        data: { id: id, __RequestVerificationToken: token },
                        success: function(response) {
                            if (response.success) {
                                showToast('success', response.message);
                                var row = $(`#row-${id}`);
                                row.fadeOut(500, function() { $(this).remove(); });
                            } else {
                                showToast('error', response.message);
                            }
                        }
                    });
                }
            })
        }
    </script>
}