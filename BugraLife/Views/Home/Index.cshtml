<script>
    (function () {
        var STORAGE_KEY = 'bugralife_dashboard_sections';

        function loadState() {
            try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
            catch (e) { return {}; }
        }
        function saveState(state) {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { }
        }

        var state = loadState();

        document.querySelectorAll('.dash-toggle').forEach(function (toggle) {
            var id = toggle.getAttribute('data-target');
            var body = document.getElementById(id);
            if (!body) return;

            // İlk açılış: localStorage boşsa açık gelsin, doluysa kayıtlı duruma göre.
            var collapsed = state.hasOwnProperty(id) ? state[id] === true : false;
            if (collapsed) {
                toggle.classList.add('collapsed');
                body.classList.add('collapsed');
            }

            toggle.addEventListener('click', function () {
                var isCollapsed = body.classList.toggle('collapsed');
                toggle.classList.toggle('collapsed', isCollapsed);
                state[id] = isCollapsed;
                saveState(state);
            });
        });
    })();
</script>

@section Scripts {
    <script>
        $(document).ready(function() {

            // Para maskesi (Noktalı binlik, virgüllü ondalık)
            $('body').on('keyup', '.money-input', function() {
                var val = $(this).val();
                val = val.replace(/[^0-9,]/g, '');

                if (val.indexOf(',') > -1) {
                    var parts = val.split(',');
                    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                    if (parts[1].length > 2) parts[1] = parts[1].substring(0, 2);
                    if (parts.length > 2) $(this).val(parts[0] + ',' + parts[1]);
                    else $(this).val(parts.join(','));
                } else {
                    val = val.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                    $(this).val(val);
                }
            });

            // Sabit gider kartına tıklandığında hızlı gider modalını aç
            $('.fixed-expense-card').on('click', function(e) {
                if ($(e.target).closest('a, button, form, input').length) return;

                var card = $(this);
                var expenseTypeId = card.data('expensetypeid');
                var expenseName = card.data('expensename');
                var paymentTypeId = card.data('paymenttypeid');
                var personId = card.data('personid');
                var amount = card.data('amount');
                var date = card.data('date');
                var desc = card.data('desc');
                var isPaid = card.data('ispaid') === true || card.data('ispaid') === 'true';

                $('#quick_expensetype_id').val(expenseTypeId);
                $('#quick_expensename_badge').text(expenseName);
                $('#quick_amount').val(amount || '');
                $('#quick_desc').val(desc || '');
                $('#quick_date').val(date || new Date().toISOString().split('T')[0]);

                if (amount) {
                    $('#quick_last_amount_hint').text('(Önceki: ' + amount + ' ₺)');
                } else {
                    $('#quick_last_amount_hint').text('');
                }

                if (paymentTypeId && paymentTypeId > 0) {
                    $('#quick_paymenttype').val(paymentTypeId);
                } else {
                    var firstPtVal = $('#quick_paymenttype option:eq(1)').val();
                    if (firstPtVal) $('#quick_paymenttype').val(firstPtVal);
                }

                if (personId && personId > 0) {
                    $('#quick_person').val(personId);
                } else {
                    var firstPersonVal = $('#quick_person option:first').val();
                    if (firstPersonVal) $('#quick_person').val(firstPersonVal);
                }

                if (isPaid) {
                    $('#quick_already_paid_warning').show();
                } else {
                    $('#quick_already_paid_warning').hide();
                }

                $('#quickExpenseModal').modal('show');

                setTimeout(function() {
                    $('#quick_amount').focus().select();
                }, 400);
            });

            // Hızlı Gider Formu Gönderimi (AJAX)
            $('#quickExpenseForm').on('submit', function(e) {
                e.preventDefault();
                var form = $(this);
                var btn = $('#btnQuickExpenseSubmit');

                var amountVal = $('#quick_amount').val();
                if (!amountVal || amountVal.trim() === '' || amountVal === '0,00' || amountVal === '0') {
                    if (typeof showToast === 'function') {
                        showToast('error', 'Lütfen geçerli bir tutar girin.');
                    } else {
                        alert('Lütfen geçerli bir tutar girin.');
                    }
                    return;
                }

                var paymentTypeVal = $('#quick_paymenttype').val();
                if (!paymentTypeVal) {
                    if (typeof showToast === 'function') {
                        showToast('error', 'Lütfen ödeme türünü seçin.');
                    } else {
                        alert('Lütfen ödeme türünü seçin.');
                    }
                    return;
                }

                var origText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Kaydediliyor...');

                $.ajax({
                    url: '/Expense/Create',
                    type: 'POST',
                    data: form.serialize(),
                    success: function(response) {
                        if (response.success) {
                            $('#quickExpenseModal').modal('hide');
                            if (typeof showToast === 'function') {
                                showToast('success', response.message || 'Gider kaydedildi.');
                            }
                            setTimeout(function() {
                                location.reload();
                            }, 700);
                        } else {
                            btn.prop('disabled', false).html(origText);
                            if (typeof showToast === 'function') {
                                showToast('error', response.message || 'Kayıt başarısız.');
                            } else {
                                alert(response.message || 'Kayıt başarısız.');
                            }
                        }
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(origText);
                        var msg = 'İşlem sırasında bir hata oluştu.';
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        if (typeof showToast === 'function') {
                            showToast('error', msg);
                        } else {
                            alert(msg);
                        }
                    }
                });
            });

            // --- BORÇLU / ALACAKLI SATIRINA TIKLANDIĞINDA TERSİ İŞLEM MODALINI AÇ ---
            $('.debtor-row').on('click', function(e) {
                if ($(e.target).closest('a, button, form, input').length) return;

                var row = $(this);
                var debtorId = row.data('debtorid');
                var ingredientId = row.data('ingredientid');
                var debtorName = row.data('debtorname');
                var ingredientName = row.data('ingredientname');
                var balance = parseFloat(row.data('balance')) || 0;
                var defaultAmount = row.data('defaultamount');
                var isAlacakli = row.data('isalacakli') === true || row.data('isalacakli') === 'true';

                $('#rev_debtor_id').val(debtorId);
                $('#rev_ingredient_id').val(ingredientId);
                $('#rev_debtor_badge').text(debtorName);
                $('#rev_ingredient_badge').text(ingredientName);
                $('#rev_unit_label').text(ingredientName || 'TL');
                $('#rev_amount').val(defaultAmount || '');
                $('#rev_date').val(new Date().toISOString().split('T')[0]);

                // Varsayılan Kişi
                var firstPersonId = @(ViewBag.Persons != null && ((List<Person>)ViewBag.Persons).Any() ? ((List<Person>)ViewBag.Persons).First().person_id : 0);
                $('#rev_person_id').val(firstPersonId);

                // Tersi işlem yönü ve başlıkları
                var btn = $('#btnRevSubmit');
                var title = $('#rev_modal_title');
                var currentStatusBadge = $('#rev_current_status_badge');
                var targetActionBadge = $('#rev_target_action_badge');

                if (isAlacakli) {
                    // Biz alacaklıyız (bakiye > 0). Tersi işlem: Tahsilat / Alacak Kapama -> cari bize ödedi veya borçlandık (- eklenir)
                    $('#rev_dir').val('borc'); // - işaret atılarak bakiye düşürülür
                    title.html('<i class="bi bi-arrow-down-left-circle me-2 text-warning"></i>Alacak Tahsilatı / Kapama');
                    currentStatusBadge.html('<span class="text-success"><i class="bi bi-arrow-down-left me-1"></i>Alacaklıyız (' + defaultAmount + ' ' + ingredientName + ')</span>');
                    targetActionBadge.removeClass('bg-danger').addClass('bg-warning text-dark').text('Alacak Tahsilatı (−' + ingredientName + ')');
                    btn.removeClass('btn-success btn-danger').addClass('btn-warning text-dark').html('<i class="bi bi-check-lg me-1"></i> Tahsilatı Kaydet');
                    $('#rev_desc').val(debtorName + ' alacak tahsilatı');
                    $('#rev_amount').removeClass('text-danger').addClass('text-success');
                } else {
                    // Biz borçluyuz (bakiye < 0). Tersi işlem: Borç Ödeme / Borç Kapama -> biz cariye ödedik (+ eklenir)
                    $('#rev_dir').val('alacak'); // + işaret atılarak borç sıfırlanır/düşürülür
                    title.html('<i class="bi bi-arrow-up-right-circle me-2 text-success"></i>Borç Ödemesi / Kapama');
                    currentStatusBadge.html('<span class="text-danger"><i class="bi bi-arrow-up-right me-1"></i>Borçluyuz (' + defaultAmount + ' ' + ingredientName + ')</span>');
                    targetActionBadge.removeClass('bg-warning text-dark').addClass('bg-success text-white').text('Borç Ödemesi (+' + ingredientName + ')');
                    btn.removeClass('btn-warning text-dark').addClass('btn-success text-white').html('<i class="bi bi-check-lg me-1"></i> Ödemeyi Kaydet');
                    $('#rev_desc').val(debtorName + ' borç ödemesi');
                    $('#rev_amount').removeClass('text-success').addClass('text-danger');
                }

                $('#rev_balance_hint').text('(Mevcut Bakiye: ' + defaultAmount + ' ' + ingredientName + ')');

                $('#reverseMovementModal').modal('show');
                setTimeout(function() {
                    $('#rev_amount').focus().select();
                }, 400);
            });

            // Tersi İşlem Formu Gönderimi (AJAX)
            $('#reverseMovementForm').on('submit', function(e) {
                e.preventDefault();
                var form = $(this);
                var btn = $('#btnRevSubmit');

                var amountVal = $('#rev_amount').val();
                if (!amountVal || amountVal.trim() === '' || amountVal === '0,00' || amountVal === '0') {
                    if (typeof showToast === 'function') {
                        showToast('error', 'Lütfen geçerli bir tutar girin.');
                    } else {
                        alert('Lütfen geçerli bir tutar girin.');
                    }
                    return;
                }

                var origText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Kaydediliyor...');

                var formDataArray = form.serializeArray();
                var dir = $('#rev_dir').val();

                for (var i = 0; i < formDataArray.length; i++) {
                    if (formDataArray[i].name === "movement_amount") {
                        var clean = formDataArray[i].value.replace(/\./g, '').replace('-', '').trim();
                        formDataArray[i].value = (dir === 'borc' ? '-' : '') + clean;
                        break;
                    }
                }

                $.ajax({
                    url: '/Movement/Create',
                    type: 'POST',
                    data: formDataArray,
                    success: function(response) {
                        if (response.success) {
                            $('#reverseMovementModal').modal('hide');
                            if (typeof showToast === 'function') {
                                showToast('success', response.message || 'Cari hareketi başarıyla kaydedildi.');
                            }
                            setTimeout(function() {
                                location.reload();
                            }, 700);
                        } else {
                            btn.prop('disabled', false).html(origText);
                            if (typeof showToast === 'function') {
                                showToast('error', response.message || 'Kayıt başarısız.');
                            } else {
                                alert(response.message || 'Kayıt başarısız.');
                            }
                        }
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(origText);
                        var msg = 'İşlem sırasında bir hata oluştu.';
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        if (typeof showToast === 'function') {
                            showToast('error', msg);
                        } else {
                            alert(msg);
                        }
                    }
                });
            });

            // --- PORTFÖY SATIRINA TIKLAYINCA ARTTIR / AZALT MODALI AÇMA ---
            $('.portfolio-row').click(function(e) {
                if ($(e.target).closest('a, button').length) return;

                var ingredientId = $(this).data('ingredientid');
                var ingredientName = $(this).data('ingredientname');
                var totalAmount = $(this).data('totalamount');

                $('#pf_ingredient_id').val(ingredientId);
                $('#pf_ingredient_name').text(ingredientName);
                $('#pf_current_amount').text(totalAmount);
                $('#pf_unit_label').text(ingredientName);

                // Varsayılan olarak Arttır (+) seçili gelsin
                setPortfolioActionType('arttir', ingredientName);

                $('#pf_amount').val('');

                $('#portfolioAdjustModal').modal('show');
                setTimeout(function() {
                    $('#pf_amount').focus();
                }, 400);
            });

            // Arttır / Azalt buton switch
            function setPortfolioActionType(type, ingredientName) {
                if (!ingredientName) {
                    ingredientName = $('#pf_ingredient_name').text().trim();
                }

                $('#pf_action_type').val(type);
                if (type === 'arttir') {
                    $('#pfBtnArttir').removeClass('btn-outline-success').addClass('btn-success active');
                    $('#pfBtnAzalt').removeClass('btn-danger active').addClass('btn-outline-danger');
                    $('#btnPfSubmit').removeClass('btn-danger').addClass('btn-success').html('<i class="bi bi-plus-lg me-1"></i> Varlığı Arttır');
                    $('#pf_hint').text('Kasaya eklenecek miktar (+)');
                    $('#pf_desc').val(ingredientName);
                } else {
                    $('#pfBtnAzalt').removeClass('btn-outline-danger').addClass('btn-danger active');
                    $('#pfBtnArttir').removeClass('btn-success active').addClass('btn-outline-success');
                    $('#btnPfSubmit').removeClass('btn-success').addClass('btn-danger').html('<i class="bi bi-dash-lg me-1"></i> Varlığı Azalt');
                    $('#pf_hint').text('Kasadan düşülecek miktar (-)');
                    $('#pf_desc').val(ingredientName);
                }
            }

            $('.pf-btn-type').click(function() {
                var type = $(this).data('type');
                setPortfolioActionType(type);
                $('#pf_amount').focus();
            });

            // Portföy Form Gönderimi (AJAX -> /Asset/Create)
            $('#portfolioAdjustForm').submit(function(e) {
                e.preventDefault();

                var form = $(this);
                var btn = $('#btnPfSubmit');
                var amountVal = $('#pf_amount').val().trim();

                if (!amountVal || amountVal === '0,00' || amountVal === '0') {
                    if (typeof showToast === 'function') {
                        showToast('error', 'Lütfen geçerli bir miktar girin.');
                    } else {
                        alert('Lütfen geçerli bir miktar girin.');
                    }
                    return;
                }

                var origText = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Kaydediliyor...');

                var formDataArray = form.serializeArray();
                var actionType = $('#pf_action_type').val();

                for (var i = 0; i < formDataArray.length; i++) {
                    if (formDataArray[i].name === "asset_amount") {
                        var clean = formDataArray[i].value.replace(/\./g, '').replace('-', '').trim();
                        formDataArray[i].value = (actionType === 'azalt' ? '-' : '') + clean;
                        break;
                    }
                }

                $.ajax({
                    url: '/Asset/Create',
                    type: 'POST',
                    data: formDataArray,
                    success: function(response) {
                        if (response.success) {
                            $('#portfolioAdjustModal').modal('hide');
                            if (typeof showToast === 'function') {
                                showToast('success', response.message || 'Varlık hareketi başarıyla kaydedildi.');
                            }
                            setTimeout(function() {
                                location.reload();
                            }, 700);
                        } else {
                            btn.prop('disabled', false).html(origText);
                            if (typeof showToast === 'function') {
                                showToast('error', response.message || 'Kayıt başarısız.');
                            } else {
                                alert(response.message || 'Kayıt başarısız.');
                            }
                        }
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).html(origText);
                        var msg = 'İşlem sırasında bir hata oluştu.';
                        if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                        if (typeof showToast === 'function') {
                            showToast('error', msg);
                        } else {
                            alert(msg);
                        }
                    }
                });
            });

        });
    </script>
}