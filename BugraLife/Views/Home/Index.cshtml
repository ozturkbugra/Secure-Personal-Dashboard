@model DashboardViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">

    @if (Model.PendingToDos != null && Model.PendingToDos.Any())
{
    // Döngüye girmeden önce listeyi ikiye ayıralım ki hiyerarşi tam otursun
    var today = DateTime.Today;
    var criticalToDos = Model.PendingToDos.Where(x => x.plannedtodo_date.Date <= today.AddDays(1)).ToList();
    var upcomingToDos = Model.PendingToDos.Where(x => x.plannedtodo_date.Date > today.AddDays(1) && x.plannedtodo_date.Date <= today.AddDays(7)).ToList();

    <div class="card shadow-lg mb-5 border-secondary">
        <div class="card-header border-bottom border-secondary d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <i class="bi bi-check2-square fs-3 me-2 text-primary"></i>
                <h3 class="fw-bold mb-0">
                    <a href="/PlannedToDo" class="text-decoration-none hover-link" title="Tüm Planlı İşleri Yönet">
                        Yapılacaklar Listesi <i class="bi bi-arrow-right-short small opacity-50"></i>
                    </a>
                </h3>
                <span class="badge bg-danger ms-3">@Model.PendingToDos.Count Bekleyen</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                
               
                @foreach (var todo in criticalToDos)
                {
                    var todoDate = todo.plannedtodo_date.Date;
                    bool isOverdue = todoDate < today;
                    bool isToday = todoDate == today;
                    bool isTomorrow = todoDate == today.AddDays(1);

                    string rowClass = isOverdue ? "border-start border-4 border-danger" : (isToday ? "border-start border-4 border-success" : "border-start border-4 border-warning");
                    string badgeClass = isOverdue ? "bg-danger" : (isToday ? "bg-success" : "bg-warning text-dark");
                    string dateText = isOverdue ? "GECİKTİ" : (isToday ? "BUGÜN" : "YARIN");
                    string titleColor = isOverdue ? "text-danger" : (isToday ? "text-success" : "text-warning");

                    <div class="list-group-item list-group-item-action bg-transparent d-flex justify-content-between align-items-center p-3 @rowClass row-todo-item"
                         style="border-bottom: 1px solid #373b3e;">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <form action="/PlannedToDo/Complete" method="post" onsubmit="return confirm('Bu görevi tamamlandı olarak işaretlemek istiyor musun?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="plannedtodo_id" value="@todo.plannedtodo_id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 32px; height: 32px;">
                                        <i class="bi bi-circle"></i>
                                    </button>
                                </form>
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold @titleColor">@todo.plannedtodo_description</h5>
                                <small class="text-secondary"><i class="bi bi-calendar3 me-1"></i>@todo.plannedtodo_date.ToString("dd MMMM dddd")</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge @badgeClass rounded-pill">@dateText</span>
                            @if (isOverdue)
                            {
                                var daysLate = (today - todoDate).TotalDays;
                                <div class="text-danger small fw-bold mt-1">@daysLate Gün Önce</div>
                            }
                            else if (isTomorrow)
                            {
                                <div class="text-warning small fw-bold mt-1">1 Gün Kaldı</div>
                            }
                        </div>
                    </div>
                }

                @if (upcomingToDos.Any())
                {
                    <div class="list-group-item list-group-item-action bg-dark bg-opacity-25 d-flex justify-content-between align-items-center p-3 text-info border-start border-4 border-info" 
                         data-bs-toggle="collapse" 
                         href="#collapseUpcomingToDos" 
                         role="button" 
                         aria-expanded="false" 
                         style="cursor: pointer; border-bottom: 1px solid #373b3e;">
                        <div class="fw-bold"><i class="bi bi-calendar-week me-2"></i> İleri Tarihli Görevler (Önümüzdeki 7 Gün)</div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-info text-dark rounded-pill">@upcomingToDos.Count İş Var</span>
                            <i class="bi bi-chevron-down small transition-transform"></i>
                        </div>
                    </div>

                    <div class="collapse" id="collapseUpcomingToDos">
                        @foreach (var todo in upcomingToDos)
                        {
                            var todoDate = todo.plannedtodo_date.Date;
                            var daysLeft = (todoDate - today).TotalDays;

                            <div class="list-group-item list-group-item-action bg-transparent d-flex justify-content-between align-items-center p-3 border-start border-4 border-info row-todo-item"
                                 style="border-bottom: 1px solid #373b3e; padding-left: 2rem !important;">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <form action="/PlannedToDo/Complete" method="post" onsubmit="return confirm('Bu görevi tamamlandı olarak işaretlemek istiyor musun aga?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="plannedtodo_id" value="@todo.plannedtodo_id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle" style="width: 32px; height: 32px;">
                                                <i class="bi bi-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-bold text-info">@todo.plannedtodo_description</h5>
                                        <small class="text-secondary"><i class="bi bi-calendar3 me-1"></i>@todo.plannedtodo_date.ToString("dd MMMM dddd")</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-info text-dark rounded-pill">BU HAFTA</span>
                                    <div class="text-info small fw-bold mt-1">@daysLeft Gün Kaldı</div>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success border-success text-center mb-5 shadow-lg" style="color: #75b798;">
        <i class="bi bi-emoji-sunglasses fs-4 me-2"></i>
        <strong>Harika!</strong> Yakın zamanda yapacak hiçbir işin yok.
    </div>
}    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-wallet2 fs-3 me-2 text-info"></i>
        <h3 class="fw-bold  mb-0">Anlık Hesap Durumları</h3>
    </div>

    <div class="row g-3 mb-5">
        @foreach (var acc in Model.Accounts)
        {
            // Kart Rengi Belirleme
            string borderClass = "border-acc-cash";
            string icon = "bi-cash-coin";
            string textClass = "text-info";

            if (acc.IsCreditCard)
            {
                borderClass = "border-acc-card";
                icon = "bi-credit-card";
                textClass = "text-danger"; // Kart rengi pembe/kırmızı ton
            }
            else if (acc.Type == "Banka Hesabı")
            {
                borderClass = "border-acc-bank";
                icon = "bi-bank";
                textClass = "text-primary"; // Banka mor/mavi
            }

            // Tutar Rengi
            // Kredi kartı eksi ise normaldir (Borçtur), ama yine de kırmızı gösterelim dikkat çeksin.
            string amountColor = acc.Balance >= 0 ? "text-success" : "text-danger";

            <div class="col-md-6 col-lg-3">
                <div class="card status-card h-100 shadow-lg @borderClass">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="text-secondary small text-uppercase fw-bold mb-1">@acc.Type</h6>
                                <h5 class="card-title fw-bold  mb-0">@acc.AccountName</h5>
                            </div>
                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                <i class="bi @icon @textClass fs-5"></i>
                            </div>
                        </div>

                        <div class="mt-3">
                            <h3 class="fw-bold mb-0 @amountColor">
                                @acc.Balance.ToString("N2") ₺
                            </h3>
                            @if (acc.IsCreditCard)
                            {
                                <small class="text-secondary" style="font-size: 0.75rem;">
                                    @(acc.Balance < 0 ? "Güncel Borç" : "Artı Bakiye")
                                </small>
                            }
                            else
                            {
                                <small class="text-secondary" style="font-size: 0.75rem;">Mevcut Bakiye</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>


    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-speedometer2 fs-3 me-2 text-warning"></i>
        <h3 class="fw-bold mb-0">Bu Ayın Sabit Gider Durumu</h3>
    </div>

    @if (Model.FixedExpenseStatuses.Any())
    {
        <div class="row g-3">
            @foreach (var item in Model.FixedExpenseStatuses)
            {
                <div class="col-md-6 col-lg-3">
                    @if (item.IsPaid)
                    {
                        <div class="card status-card h-100 border-paid shadow-lg">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold text-success mb-0">@item.ExpenseName</h5>
                                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                </div>
                                <p class="card-text text-secondary mb-0 small">Son Ödeme: @item.DueDate.ToString("dd MMMM")</p>
                                <div class="mt-3">
                                    <span class="badge bg-success bg-opacity-25 text-success w-100">ÖDENDİ</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (item.DaysDiff < 0)
                        {
                            // DaysDiff negatif (örn: -5), pozitife çevirip gösteriyoruz
                            var lateDays = Math.Abs(item.DaysDiff);

                            <div class="card status-card h-100 border-late shadow-lg">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold text-danger mb-0">@item.ExpenseName</h5>
                                        <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                                    </div>
                                    <p class="card-text text-secondary mb-0 small">Son Ödeme: @item.DueDate.ToString("dd MMMM")</p>
                                    <div class="mt-3 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-danger bg-opacity-25 text-danger flex-grow-1 me-2">ÖDENMEDİ</span>
                                        <span class="text-danger fw-bold small">@lateDays Gün Geçti!</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (item.DaysDiff == 0)
                        {
                            <div class="card status-card h-100 border-wait shadow-lg">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold text-warning mb-0">@item.ExpenseName</h5>
                                        <i class="bi bi-alarm-fill text-warning fs-4"></i>
                                    </div>
                                    <p class="card-text text-secondary mb-0 small">Son Ödeme: BUGÜN</p>
                                    <div class="mt-3">
                                        <span class="badge bg-warning bg-opacity-25 text-warning w-100">BUGÜN SON GÜN</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card status-card h-100 border-wait shadow-lg">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold mb-0">@item.ExpenseName</h5>
                                        <i class="bi bi-hourglass-split text-info fs-4"></i>
                                    </div>
                                    <p class="card-text text-secondary mb-0 small">Son Ödeme: @item.DueDate.ToString("dd MMMM")</p>
                                    <div class="mt-3 d-flex justify-content-between align-items-center">
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary flex-grow-1 me-2">BEKLİYOR</span>
                                        <span class="text-info fw-bold small">@item.DaysDiff Gün Kaldı</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-dark border-secondary text-center">
            <i class="bi bi-info-circle me-2"></i>Henüz takip edilen sabit gider yok. <a href="/FixedExpense/Index" class="text-warning fw-bold">Buradan ekle aga.</a>
        </div>
    }



    <div class="row g-4 mt-2">
        <!-- SOL: PORTFÖY (Kasamdakiler) -->
        <div class="col-lg-4">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-briefcase fs-4 me-2 text-info"></i>
                <h4 class="fw-bold mb-0">Portföy</h4>
            </div>
            <div class="card shadow-lg border-0 overflow-hidden">
                <!-- DÜZELTME BURADA: table-responsive ayrı bir div olarak içeriye alındı -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead class="small">
                            <tr>
                                <th class="ps-4">Varlık</th>
                                <th class="text-end pe-4">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PortfolioBalances)
                            {
                                <tr>
                                    <td class="ps-4 py-3 text-info">@p.IngredientName</td>
                                    <td class="text-end pe-4 fw-bold">@p.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SAĞ: BORÇ / ALACAK LİSTESİ -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-person-lines-fill fs-4 me-2 text-warning"></i>
                <h4 class="fw-bold mb-0">Borç / Alacak Listesi</h4>
            </div>
            <div class="card shadow-lg border-0 overflow-hidden">
                <!-- DÜZELTME BURADA: table-responsive ayrı bir div olarak içeriye alındı -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead class="small">
                            <tr>
                                <th class="ps-4">Kişi / Kurum</th>
                                <th>Varlık Türü</th>
                                <th class="text-center">Durum</th>
                                <th class="text-end pe-4">Bakiye</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.DebtorBalances)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-white">@d.Name</td>
                                    <td><span class="badge bg-danger">@d.IngredientName</span></td>
                                    <td class="text-center">
                                        @if (d.Balance > 0)
                                        {
                                            <span class="text-success small fw-bold">Alacaklıyız</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small fw-bold">Borçluyuz</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 fw-bold @(d.Balance > 0 ? "text-success" : "text-danger")">
                                        @d.Balance.ToString("N2") <small>@d.IngredientName</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>