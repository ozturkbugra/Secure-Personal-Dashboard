@model BugraLife.Models.FitnessExercise

<div class="col-6 col-md-4 col-lg-3" id="ex-@Model.fitnessexercise_id">
    <div class="fit-card h-100 d-flex flex-column">
        <div class="fit-media">
            @if (!string.IsNullOrEmpty(Model.fitnessexercise_image))
            {
                <img src="@Model.fitnessexercise_image" alt="@Model.fitnessexercise_name">
            }
            else
            {
                <i class="bi bi-person-arms-up fit-ph"></i>
            }
        </div>
        <div class="p-2 flex-fill">
            <h6 class="fw-bold mb-1 fit-strong">@Model.fitnessexercise_name</h6>
            <p class="fit-sub small mb-0" style="white-space:pre-line;">@Model.fitnessexercise_description</p>
        </div>
        <div class="p-2 d-flex gap-2">
            <button class="btn btn-warning btn-sm text-white flex-fill btn-ex-edit"
                    data-id="@Model.fitnessexercise_id" data-name="@Model.fitnessexercise_name"
                    data-desc="@Model.fitnessexercise_description" data-img="@Model.fitnessexercise_image"
                    onclick="openEdit(this)"><i class="bi bi-pencil-square"></i></button>
            <button class="btn btn-danger btn-sm flex-fill" onclick="deleteExercise(@Model.fitnessexercise_id)"><i class="bi bi-trash"></i></button>
        </div>
    </div>
</div>
