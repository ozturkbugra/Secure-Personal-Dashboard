@model InstallmentReportViewModel

@{
    ViewData["Title"] = Model.IsHistory ? "Geçmiş Taksitler Raporu" : "Kalan Taksitler Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<style>
    .inst-month-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid var(--border-color);
        background-color: var(--card-bg);
    }
    .inst-month-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .inst-month-header {
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 1.25rem;
        background: rgba(var(--bs-primary-rgb, 13, 110, 253), 0.04);
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
    .inst-acc-header {
        cursor: pointer;
        user-select: none;
        padding: 0.85rem 1.15rem;
        background-color: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        transition: background-color 0.2s ease;
    }
    .inst-acc-header:hover {
        background-color: rgba(var(--bs-primary-rgb, 13, 110, 253), 0.06);
    }
    .inst-acc-header .inst-chevron {
        transition: transform 0.25s ease;
    }
    .inst-acc-header[aria-expanded="true"] .inst-chevron {
        transform: rotate(180deg);
    }
    .inst-table {
        margin-bottom: 0;
        font-size: 0.9rem;
    }
    .inst-table th {
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        border-bottom-color: var(--border-color);
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
    }
    .inst-table td {
        border-bottom-color: var(--border-color);
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
        color: var(--text-color);
    }
</style>

<div class="container mt-4">

    <!-- ÜST BAŞLIK & GEÇİŞ BUTONLARI -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center">
            <div class="p-3 rounded-circle me-3 @(Model.IsHistory ? "bg-secondary bg-opacity-10 text-secondary" : "bg-danger bg-opacity-10 text-danger")">
                <i class="bi @(Model.IsHistory ? "bi-clock-history" : "bi-calendar2-week") fs-3"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-theme">@(Model.IsHistory ? "Geçmiş Taksitler Raporu" : "Kalan Taksitler Raporu")</h3>
                <span class="text-secondary small">
                    @(Model.IsHistory 
                        ? "Önceki aylarda ödenmiş ve tamamlanan tüm taksit dökümleri" 
                        : "Ay ay ve kredi kartı bazında gelecek dönem taksit ödemeleri")
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (Model.IsHistory)
            {
                <a href="/Report/Installments" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                    <i class="bi bi-hourglass-split me-1"></i> Kalan Taksitleri Gör
                </a>
            }
            else
            {
                <a href="/Report/InstallmentsHistory" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                    <i class="bi bi-clock-history me-1"></i> Geçmiş Taksitleri Gör
                </a>
            }

            <div class="btn-group">
                <a href="/Report/InstallmentsExport?format=excel&isHistory=@Model.IsHistory" class="btn btn-success btn-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Excel
                </a>
                <a href="/Report/InstallmentsExport?format=pdf&isHistory=@Model.IsHistory" class="btn btn-danger btn-sm">
                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                </a>
            </div>
        </div>
    </div>

    <!-- ÖZET KARTLAR -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card status-card h-100 shadow-sm border-start border-4 @(Model.IsHistory ? "border-secondary" : "border-danger")">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-secondary small text-uppercase fw-bold mb-1">
                            @(Model.IsHistory ? "Toplam Ödenmiş Taksit" : "Toplam Kalan Taksit Yükü")
                        </h6>
                        <h3 class="fw-bold mb-0 @(Model.IsHistory ? "text-secondary" : "text-danger")">
                            @Model.TotalAmount.ToString("N2", trCulture) ₺
                        </h3>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center @(Model.IsHistory ? "bg-secondary bg-opacity-10 text-secondary" : "bg-danger bg-opacity-10 text-danger")" style="width: 52px; height: 52px;">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card status-card h-100 shadow-sm border-start border-4 border-info">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-secondary small text-uppercase fw-bold mb-1">Dönem Sayısı</h6>
                        <h3 class="fw-bold mb-0 text-info">@Model.DistinctMonthCount Ay</h3>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info" style="width: 52px; height: 52px;">
                        <i class="bi bi-calendar3 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card status-card h-100 shadow-sm border-start border-4 border-warning">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-secondary small text-uppercase fw-bold mb-1">Toplam Taksit Adedi</h6>
                        <h3 class="fw-bold mb-0 text-warning">@Model.TotalCount Adet</h3>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning" style="width: 52px; height: 52px;">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AY AY GRUPLANMIŞ LİSTE -->
    @if (!Model.Months.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            <strong>Kayıt Bulunamadı!</strong> 
            @(Model.IsHistory ? "Geçmişe ait herhangi bir taksitli harcama kaydı bulunmuyor." : "Gelecek dönemlere ait ödenecek herhangi bir taksit bulunmuyor.")
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @for (int mIdx = 0; mIdx < Model.Months.Count; mIdx++)
            {
                var month = Model.Months[mIdx];
                string monthId = $"month-{month.Year}-{month.Month}";

                <div class="card inst-month-card shadow-sm">
                    <!-- AY BAŞLIĞI -->
                    <div class="inst-month-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Model.IsHistory ? "bg-secondary" : "bg-danger") rounded-pill px-3 py-2 fw-bold fs-6">
                                <i class="bi bi-calendar-event me-1"></i> @month.MonthName (@month.Month.ToString("D2"). Ay)
                            </span>
                            <span class="badge bg-light text-dark border small">@month.InstallmentCount Taksit</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-secondary small">Ay Toplamı:</span>
                            <h4 class="fw-bold mb-0 @(Model.IsHistory ? "text-secondary" : "text-danger")">
                                @month.MonthTotal.ToString("N2", trCulture) ₺
                            </h4>
                        </div>
                    </div>

                    <!-- AY İÇİNDEKİ KARTLAR / HESAPLAR -->
                    <div class="card-body p-3 d-flex flex-column gap-3">
                        @for (int aIdx = 0; aIdx < month.Accounts.Count; aIdx++)
                        {
                            var acc = month.Accounts[aIdx];
                            string collapseId = $"collapse-{month.Year}-{month.Month}-{acc.PaymentTypeId}";
                            bool isDefaultOpen = (mIdx == 0); // Sadece ilk ayın kartları varsayılan olarak açık gelsin

                            <div class="border rounded-3 overflow-hidden" style="border-color: var(--border-color) !important;">
                                <!-- KART / HESAP BAŞLIĞI (COLLAPSE TETİKLEYİCİ) -->
                                <div class="inst-acc-header d-flex justify-content-between align-items-center"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#@collapseId"
                                     aria-expanded="@(isDefaultOpen ? "true" : "false")"
                                     role="button">

                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width: 38px; height: 38px;">
                                            <i class="bi bi-credit-card-2-front fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-theme">@acc.AccountName</div>
                                            <div class="text-secondary small">
                                                <i class="bi bi-credit-card me-1"></i>Kredi Kartı • @acc.InstallmentCount Taksit
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-3">
                                        <div class="text-end">
                                            <div class="fw-bold fs-6 @(Model.IsHistory ? "text-secondary" : "text-danger")">
                                                @acc.AccountTotal.ToString("N2", trCulture) ₺
                                            </div>
                                            <small class="text-secondary" style="font-size: 0.72rem;">detay için tıkla</small>
                                        </div>
                                        <i class="bi bi-chevron-down inst-chevron text-secondary"></i>
                                    </div>
                                </div>

                                <!-- KART DETAY TABLOSU (COLLAPSE İÇERİĞİ) -->
                                <div class="collapse @(isDefaultOpen ? "show" : "")" id="@collapseId">
                                    <div class="table-responsive bg-transparent">
                                        <table class="table inst-table align-middle">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3" style="width: 110px;">Vade</th>
                                                    <th>Gider Türü</th>
                                                    <th>Açıklama / Taksit Detayı</th>
                                                    <th>Kişi</th>
                                                    <th class="text-end pe-3" style="width: 140px;">Tutar</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in acc.Items)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-bold text-secondary">
                                                            <i class="bi bi-calendar3 me-1"></i>@item.ExpenseDate.ToString("dd.MM.yyyy")
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">
                                                                @item.ExpenseTypeName
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="fw-semibold text-theme">@item.Description</div>
                                                            @if (!string.IsNullOrEmpty(item.InstallmentInfo))
                                                            {
                                                                <small class="badge bg-info bg-opacity-10 text-info border border-info mt-1">
                                                                    @item.InstallmentInfo
                                                                </small>
                                                            }
                                                        </td>
                                                        <td class="text-secondary small">
                                                            @item.PersonName
                                                        </td>
                                                        <td class="text-end pe-3 fw-bold @(Model.IsHistory ? "text-secondary" : "text-danger")">
                                                            @item.Amount.ToString("N2", trCulture) ₺
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>
