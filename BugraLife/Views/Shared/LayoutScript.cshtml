<script>
    /* =========================================================
       BugraLife Admin Panel - Ana JavaScript Dosyası (SABİT SÜRÜM)
       ========================================================= */

    function showToast(icon, title) {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        Toast.fire({
            icon: icon,
            title: title
        });
    }

    $(document).ready(function() {

        // =========================================================
        // 2. SIDEBAR (SOL MENÜ) KESİN VE SABİT AÇIK TUTMA
        // =========================================================
           // =========================================================
    // 2. SIDEBAR (SOL MENÜ) VARSAYILAN AÇIK VE TOGGLE İŞLEVİ
    // =========================================================
    const wrapper = document.getElementById('wrapper');

    // Sayfa İLK yüklendiğinde her durumda menüyü AÇIK başlatıyoruz (toggled class'ını siliyoruz)
    if (wrapper) {
        wrapper.classList.remove('toggled');
    }

    // Eski hafıza kaydını temizle ki ilk yüklemede kapalı gelmeye zorlamasın
    localStorage.removeItem('sb|sidebar-toggle');

    // Hamburger ve mobil kapatma butonuna basınca esnek şekilde açılıp kapansın
    $("#menu-toggle, #sidebar-close-btn").off('click').on('click', function(e) {
        if (e) e.preventDefault();
        if (wrapper) {
            wrapper.classList.toggle('toggled');
        }
    });


        // --- C. Alt Menülerin (Collapse) Açık Kalmasını Sağla ---
        var activeSubmenus = JSON.parse(localStorage.getItem('activeSubmenus')) || [];
        activeSubmenus.forEach(function(id) {
            var element = $('#' + id);
            if (element.length) {
                element.addClass('show');
                var toggleBtn = $('a[href="#' + id + '"]');
                toggleBtn.removeClass('collapsed').attr('aria-expanded', 'true');
            }
        });

        $('.collapse').on('shown.bs.collapse', function () {
            var currentId = $(this).attr('id');
            if($(this).parents('#sidebar-menu').length) {
                var storedIds = JSON.parse(localStorage.getItem('activeSubmenus')) || [];
                if (!storedIds.includes(currentId)) {
                    storedIds.push(currentId);
                    localStorage.setItem('activeSubmenus', JSON.stringify(storedIds));
                }
            }
        });

        $('.collapse').on('hidden.bs.collapse', function () {
            var currentId = $(this).attr('id');
            if($(this).parents('#sidebar-menu').length) {
                var storedIds = JSON.parse(localStorage.getItem('activeSubmenus')) || [];
                storedIds = storedIds.filter(id => id !== currentId);
                localStorage.setItem('activeSubmenus', JSON.stringify(storedIds));
            }
        });


        // --- AKILLI MENÜ ARAMA ---
        $('#menu-search-input').on('keyup', function() {
            var value = $(this).val().toLowerCase();

            $('.list-group-item').filter(function() {
                var text = $(this).text().toLowerCase();
                var isMatch = text.indexOf(value) > -1;

                if (value === "") {
                    $('.collapse').removeClass('show');
                    activeSubmenus.forEach(function(id) { $('#' + id).addClass('show'); });
                    $(this).toggle(true);
                    return;
                }

                if (isMatch) {
                    $(this).toggle(true);
                    $(this).closest('.collapse').addClass('show');
                    var collapseId = $(this).closest('.collapse').attr('id');
                    if(collapseId) {
                        $('a[href="#' + collapseId + '"]').toggle(true);
                    }
                } else {
                    $(this).toggle(false);
                }
            });
        });


        // =========================================================
        // 3. MOBİL ARAMA
        // =========================================================
        $("#mobile-search-toggle").click(function() {
            $("#search-container-wrapper").toggleClass("active");
            if ($("#search-container-wrapper").hasClass("active")) {
                $("#menu-search-input").focus();
            }
        });


        // =========================================================
        // 4. DATATABLES OTOMATİK KURULUM
        // =========================================================
        if ($.fn.DataTable) {
            $('.datatable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                responsive: true,
                drawCallback: function() {
                    $('.page-link').addClass('shadow-sm');
                }
            });
        }


        // =========================================================
        // 5. DARK MODE (GECE MODU)
        // =========================================================
        const themeToggleBtn = document.getElementById('dark-mode-toggle');
        const themeIcon = document.getElementById('theme-icon');

        if (themeToggleBtn) {
            const currentTheme = localStorage.getItem('theme');
            if (currentTheme) {
                document.documentElement.setAttribute('data-theme', currentTheme);
                if (currentTheme === 'dark') {
                    themeIcon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                }
            }

            themeToggleBtn.addEventListener('click', () => {
                let theme = document.documentElement.getAttribute('data-theme');
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                    themeIcon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    themeIcon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                }
            });
        }


        // =========================================================
        // 6. AGA SELECT (AKILLI SEÇİM KUTUSU)
        // =========================================================
        $('.aga-select').each(function() {
            const originalSelect = $(this);
            const isMulti = originalSelect.prop('multiple');

            originalSelect.hide();

            let optionsHtml = '';
            originalSelect.find('option').each(function() {
                const val = $(this).val();
                const text = $(this).text();
                const isSelected = $(this).is(':selected');

                if (val === "") return;

                if (isMulti) {
                    optionsHtml += `
                        <label class="aga-option-item ${isSelected ? 'selected' : ''}">
                            <input type="checkbox" value="${val}" data-text="${text}" ${isSelected ? 'checked' : ''}>
                            <span>${text}</span>
                        </label>
                    `;
                } else {
                    optionsHtml += `
                        <div class="aga-option-item ${isSelected ? 'selected' : ''}" data-value="${val}" data-text="${text}">
                            <span>${text}</span>
                        </div>
                    `;
                }
            });

            const selectAllHtml = isMulti ? '<span class="select-all-btn">Tümünü Seç / Kaldır</span>' : '';

            const wrapper = $(`
                <div class="aga-select-wrapper">
                    <div class="aga-select-trigger">Seçiniz...</div>
                    <div class="aga-select-dropdown">
                        <input type="text" class="aga-search-box" placeholder="Ara...">
                        ${selectAllHtml}
                        <div class="aga-options-list">
                            ${optionsHtml}
                        </div>
                    </div>
                </div>
            `);

            originalSelect.after(wrapper);

            const trigger = wrapper.find('.aga-select-trigger');
            const dropdown = wrapper.find('.aga-select-dropdown');
            const searchBox = wrapper.find('.aga-search-box');

            function updateTriggerText() {
                if (isMulti) {
                    const checked = wrapper.find('input[type="checkbox"]:checked');
                    if (checked.length > 0) {
                        if (checked.length > 2) {
                            trigger.text(checked.length + " kayıt seçildi");
                        } else {
                            const texts = checked.map(function() { return $(this).attr('data-text'); }).get();
                            trigger.text(texts.join(', '));
                        }
                        trigger.css('color', 'var(--text-color)');
                    } else {
                        trigger.text("Seçiniz...");
                        trigger.css('color', 'var(--text-muted)');
                    }
                } else {
                    const selected = wrapper.find('.aga-option-item.selected');
                    if (selected.length > 0) {
                        trigger.text(selected.data('text'));
                        trigger.css('color', 'var(--text-color)');
                    } else {
                        trigger.text("Seçiniz...");
                        trigger.css('color', 'var(--text-muted)');
                    }
                }
            }

            updateTriggerText();

            originalSelect.on('change', function() {
                const newVal = $(this).val();
                if (!isMulti) {
                    wrapper.find('.aga-option-item').removeClass('selected');
                    if(newVal) {
                        wrapper.find(`.aga-option-item[data-value='${newVal}']`).addClass('selected');
                    }
                }
                updateTriggerText();
            });

            trigger.on('click', function(e) {
                e.stopPropagation();
                $('.aga-select-dropdown').not(dropdown).removeClass('active');
                dropdown.toggleClass('active');
                if(dropdown.hasClass('active')) {
                    searchBox.focus();
                }
            });

            $(document).on('click', function() {
                dropdown.removeClass('active');
            });
            dropdown.on('click', function(e) { e.stopPropagation(); });

            searchBox.on('keyup', function() {
                const value = $(this).val().toLocaleLowerCase('tr-TR');
                wrapper.find('.aga-option-item').filter(function() {
                    $(this).toggle($(this).text().toLocaleLowerCase('tr-TR').indexOf(value) > -1)
                });
            });

            if (isMulti) {
                const selectAllBtn = wrapper.find('.select-all-btn');
                const checkboxes = wrapper.find('input[type="checkbox"]');

                selectAllBtn.on('click', function() {
                    const allChecked = checkboxes.length === checkboxes.filter(':checked').length;
                    checkboxes.prop('checked', !allChecked).trigger('change');
                });

                checkboxes.on('change', function() {
                    const selectedValues = [];
                    checkboxes.filter(':checked').each(function() {
                        selectedValues.push($(this).val());
                        $(this).closest('.aga-option-item').addClass('selected');
                    });
                    checkboxes.not(':checked').closest('.aga-option-item').removeClass('selected');
                    originalSelect.val(selectedValues);
                    updateTriggerText();
                });

            } else {
                const items = wrapper.find('.aga-option-item');
                items.on('click', function() {
                    const val = $(this).data('value');
                    items.removeClass('selected');
                    $(this).addClass('selected');
                    originalSelect.val(val).trigger('change');
                    dropdown.removeClass('active');
                });
            }
        });


        // --- MENÜ LİNKLERİNİ AKTİF YAPMA ---
        var currentUrl = window.location.pathname.toLowerCase();
        if (currentUrl === "/" || currentUrl === "") currentUrl = "/home";

        $("#sidebar-menu .menu-item").each(function() {
            var linkUrl = $(this).attr("href").toLowerCase();

            if (currentUrl === linkUrl || (currentUrl.startsWith(linkUrl) && linkUrl !== "/home" && linkUrl !== "/")) {
                $(this).addClass("active-menu");
                $(this).removeClass("bg-transparent second-text");

                var parentCollapse = $(this).closest(".collapse");
                if (parentCollapse.length > 0) {
                    parentCollapse.addClass("show");
                    var parentId = parentCollapse.attr("id");
                    var parentToggle = $('a[href="#' + parentId + '"]');
                    parentToggle.addClass("active-parent");
                    parentToggle.removeClass("collapsed");
                    parentToggle.attr("aria-expanded", "true");
                }
            }
        });
    });

    // --- KLAVYE ARAMA KISAYOLU ---
    $(document).on('keydown', function(e) {
        if ($(e.target).is('input, textarea, select') || e.ctrlKey || e.altKey || e.metaKey) {
            return;
        }
        if (e.key.length === 1) {
            var searchInput = $("#menu-search-input");
            searchInput.focus();
        }
    });

    if ($(window).width() > 768) {
         $("#menu-search-input").focus();
    }

    // --- FAVORİ İŞLEMLERİ ---
    function loadFavorites() {
        var favs = JSON.parse(localStorage.getItem('bugraLifeFavs')) || [];
        var listHtml = '';
        var currentPath = window.location.pathname;

        if (favs.length === 0) {
            $('#favorites-list').html('<li class="text-center text-muted small py-2">Henüz favori yok.</li>');
            $('#fav-count').hide();
        } else {
            favs.forEach(function(item, index) {
                listHtml += `
                    <li class="d-flex justify-content-between align-items-center px-3 py-1 mb-1">
                        <a class="dropdown-item rounded text-truncate px-2" href="${item.url}" style="font-size: 0.9rem;">
                            <i class="bi bi-bookmark-fill text-primary me-2 opacity-50"></i>${item.title}
                        </a>
                        <button class="btn btn-link text-danger btn-sm p-0 ms-2" onclick="removeFavorite(${index}); event.stopPropagation();">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </li>
                `;
            });
            $('#favorites-list').html(listHtml);
            $('#fav-count').text(favs.length).show();
        }

        var exists = favs.some(f => f.url === currentPath);
        updateFavButton(exists);
    }

    function updateFavButton(isFav) {
        var btn = $('#btn-toggle-fav');
        if (isFav) {
            btn.removeClass('btn-outline-warning').addClass('btn-danger');
            btn.html('<i class="bi bi-trash me-1"></i> Favoriden Çıkar');
        } else {
            btn.removeClass('btn-danger').addClass('btn-outline-warning');
            btn.html('<i class="bi bi-star-fill me-1"></i> Bu Sayfayı Ekle');
        }
    }

    $('#btn-toggle-fav').click(function(e) {
        e.stopPropagation();

        var favs = JSON.parse(localStorage.getItem('bugraLifeFavs')) || [];
        var currentPath = window.location.pathname;
        var currentTitle = document.title.replace(' - BugraLife Panel', '');

        var existingIndex = favs.findIndex(f => f.url === currentPath);

        if (existingIndex > -1) {
            favs.splice(existingIndex, 1);
            showToast('info', 'Favorilerden çıkarıldı.');
        } else {
            favs.push({ title: currentTitle, url: currentPath });
            showToast('success', 'Favorilere eklendi.');
        }

        localStorage.setItem('bugraLifeFavs', JSON.stringify(favs));
        loadFavorites();
    });

    window.removeFavorite = function(index) {
        var favs = JSON.parse(localStorage.getItem('bugraLifeFavs')) || [];
        favs.splice(index, 1);
        localStorage.setItem('bugraLifeFavs', JSON.stringify(favs));
        loadFavorites();
        showToast('info', 'Silindi.');
    };

    loadFavorites();
</script>